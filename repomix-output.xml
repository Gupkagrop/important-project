    lst: LinkedList[int] = LinkedList([1, 2, 3, 4])
    lst.clear()
    assert len(lst) == 0
    assert lst.is_empty() is True
    assert lst.to_list() == []


def test_linked_list_contains() -> None:
    """Проверка оператора принадлежности `in`."""
